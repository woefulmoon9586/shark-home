---
import { Activity, ArrowRight, BookOpen, Cpu, FolderKanban, Radio } from '@lucide/astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
import { getPublishedPosts } from '../lib/collections';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalIntro from '../components/TerminalIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import TagBadge from '../components/TagBadge.astro';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const featuredProjects = allProjects.filter(({ data }) => data.featured === true);
const allPosts = await getPublishedPosts();
const latestPosts = allPosts.slice(0, 4);
const blogCategories = new Set(
  allPosts.map((post) => post.id.split('/')[0]).filter(Boolean)
);
const projectCategories = new Set(
  allProjects.map((project) => project.id.split('/')[0]).filter(Boolean)
);
const totalCategories = new Set([...blogCategories, ...projectCategories]).size;
const latestPostDate =
  latestPosts[0]?.data.displayDate ??
  latestPosts[0]?.data.date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }) ??
  'standby';

const monitorStats = [
  {
    label: '文章日志',
    value: String(allPosts.length).padStart(2, '0'),
    hint: 'published posts',
    icon: BookOpen,
  },
  {
    label: '项目构建',
    value: String(allProjects.length).padStart(2, '0'),
    hint: 'active builds',
    icon: FolderKanban,
  },
  {
    label: '分类频道',
    value: String(totalCategories).padStart(2, '0'),
    hint: 'content routes',
    icon: Cpu,
  },
];

const techSignals = ['Astro', 'Tailwind CSS', 'TypeScript', 'Java', 'Vue', 'Node.js'];

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": siteConfig.author,
  "url": "https://home.woefulmoon.top",
  "jobTitle": siteConfig.description,
  "sameAs": [siteConfig.github],
};
---

<BaseLayout container="wide">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <div class="space-y-8 sm:space-y-10 lg:space-y-12">
    <section class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.08fr)_minmax(21rem,0.92fr)]">
      <TerminalIntro />

      <aside class="hidden gap-4 xl:sticky xl:top-24 xl:grid">
        <figure class="glow-card scanline overflow-hidden p-2">
          <img
            src="/assets/home/shark-command-core.webp"
            width="1200"
            height="900"
            alt={`${siteConfig.author} 的暗黑终端控制台视觉`}
            class="aspect-[16/10] w-full rounded-md object-cover"
            decoding="async"
            fetchpriority="high"
          />
        </figure>

        <div class="terminal-panel p-5">
          <div class="relative z-10 mb-5 flex items-center justify-between gap-3">
            <div>
              <p class="font-mono text-xs uppercase text-green">system.monitor</p>
              <h2 class="text-xl font-semibold text-text">内容信号</h2>
            </div>
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-green/25 bg-green/10 text-green">
              <Activity size={20} aria-hidden="true" />
            </span>
          </div>

          <dl class="relative z-10 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
            {monitorStats.map((stat) => {
              const Icon = stat.icon;
              return (
                <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 border-b border-border/70 pb-3 last:border-b-0 last:pb-0 sm:border-b-0 sm:border-r sm:pb-0 sm:pr-3 sm:last:border-r-0 sm:last:pr-0 lg:border-b lg:border-r-0 lg:pb-3 lg:pr-0 lg:last:border-b-0 lg:last:pb-0">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-bg/45 text-accent">
                    <Icon size={17} aria-hidden="true" />
                  </span>
                  <div>
                    <dt class="font-mono text-xs text-text-muted">{stat.label}</dt>
                    <dd class="font-mono text-xs text-text-muted">{stat.hint}</dd>
                  </div>
                  <dd class="font-mono text-2xl font-semibold text-text">{stat.value}</dd>
                </div>
              );
            })}
          </dl>

          <div class="relative z-10 mt-5 border-t border-border/80 pt-5">
            <div class="mb-3 flex items-center gap-2 font-mono text-xs text-green">
              <Radio size={14} aria-hidden="true" />
              last log: {latestPostDate}
            </div>
            <div class="flex flex-wrap gap-1.5">
              {techSignals.map((tech) => (
                <TagBadge label={tech} variant="muted" />
              ))}
            </div>
          </div>
        </div>
      </aside>
    </section>

    <section aria-labelledby="featured-build-heading" class="grid gap-5">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="section-kicker">featured project</span>
          <h2 id="featured-build-heading" class="mt-3 text-2xl font-semibold text-text sm:text-3xl">
            精选构建
          </h2>
        </div>
        <a href="/projects/" class="command-button command-button-secondary px-4">
          全部项目
          <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>

      {featuredProjects.length > 0 ? (
        <div class="grid gap-4">
          <ProjectCard project={featuredProjects[0]} variant="featured" />
          {featuredProjects.length > 1 && (
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {featuredProjects.slice(1).map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          )}
        </div>
      ) : (
        <div class="glow-card p-6 font-mono text-sm text-text-muted">
          <span class="text-green">$</span> build queue is empty. 新项目会在这里点亮。
        </div>
      )}
    </section>

    <section aria-labelledby="latest-log-heading" class="grid gap-5 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
      <div>
        <span class="section-kicker">latest log stream</span>
        <h2 id="latest-log-heading" class="mt-3 text-2xl font-semibold text-text sm:text-3xl">
          最新文章
        </h2>
        <p class="mt-4 max-w-md text-sm leading-7 text-text-muted">
          把学习路径、环境配置、项目实践和日常记录沉淀成可检索的日志。这里展示最近写下的内容。
        </p>
        {latestPosts.length > 0 && (
          <a href="/blog/" class="command-button command-button-primary mt-6 px-4">
            查看全部文章
            <ArrowRight size={16} aria-hidden="true" />
          </a>
        )}
      </div>

      <div class="glow-card overflow-hidden px-5 sm:px-6">
        {latestPosts.length > 0 ? (
          latestPosts.map((post, index) => (
            <PostCard post={post} variant="timeline" index={index} />
          ))
        ) : (
          <div class="py-8 font-mono text-sm text-text-muted">
            <span class="text-green">$</span> no logs yet.
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
