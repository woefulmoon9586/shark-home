---
import { BookOpen, Command, FolderKanban, GitBranch, Mail, Menu, User, X } from '@lucide/astro';
import { siteConfig } from '../config';

const navLinks = [
  { href: '/', label: '~/shark', icon: Command },
  { href: '/projects/', label: '项目', icon: FolderKanban },
  { href: '/blog/', label: '博客', icon: BookOpen },
  { href: '/about/', label: '关于', icon: User },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<nav class="sticky top-0 z-50 border-b border-border/80 bg-bg/82 shadow-[0_12px_40px_rgba(0,0,0,0.24)] backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="group inline-flex min-h-11 items-center gap-3 font-mono text-accent hover:opacity-100" aria-label={`${siteConfig.author} 首页`}>
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-accent/35 bg-accent/10 text-sm font-semibold shadow-[0_0_22px_rgba(88,166,255,0.16)]">
        S
      </span>
      <span class="hidden text-sm font-semibold sm:inline">{siteConfig.author}</span>
    </a>

    <div class="hidden items-center gap-1 rounded-lg border border-border/80 bg-surface/55 p-1 sm:flex">
      {navLinks.map((link) => (
        <>
          {(() => {
            const Icon = link.icon;
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'relative inline-flex min-h-11 items-center gap-2 rounded-md px-3 font-mono text-sm transition-colors',
                  active
                    ? 'bg-accent/10 text-accent shadow-[0_0_20px_rgba(88,166,255,0.1)]'
                    : 'text-text-muted hover:bg-surface hover:text-text',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                <Icon size={15} aria-hidden="true" />
                {link.label}
                {active && <span class="absolute inset-x-3 -bottom-1 h-px bg-accent shadow-[0_0_12px_rgba(88,166,255,0.9)]"></span>}
              </a>
            );
          })()}
        </>
      ))}
    </div>

    <div class="hidden items-center gap-2 sm:flex">
      <a
        href={siteConfig.github}
        target="_blank"
        rel="noopener"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-surface/60 text-text-muted transition-colors hover:border-accent/40 hover:text-accent hover:opacity-100"
        aria-label="打开源码仓库"
      >
        <GitBranch size={17} aria-hidden="true" />
      </a>
      <a
        href={`mailto:${siteConfig.email}`}
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-surface/60 text-text-muted transition-colors hover:border-green/40 hover:text-green hover:opacity-100"
        aria-label="发送邮件"
      >
        <Mail size={17} aria-hidden="true" />
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-surface/70 text-text-muted transition-colors hover:text-text sm:hidden"
      aria-label="打开导航菜单"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu id="mobile-menu-open-icon" size={22} aria-hidden="true" />
      <X id="mobile-menu-close-icon" class="hidden" size={22} aria-hidden="true" />
    </button>
  </div>

  <div id="mobile-menu" role="menu" class="hidden border-t border-border/80 bg-bg/96 px-4 py-4 shadow-[0_18px_60px_rgba(0,0,0,0.32)] backdrop-blur-xl sm:hidden">
    <div class="mx-auto grid max-w-7xl gap-2">
      {navLinks.map((link) => {
        const Icon = link.icon;
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            role="menuitem"
            class:list={[
              'inline-flex min-h-11 items-center gap-3 rounded-lg px-3 font-mono text-sm transition-colors',
              active ? 'bg-accent/10 text-accent' : 'text-text-muted hover:bg-surface hover:text-text',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            <Icon size={16} aria-hidden="true" />
            {link.label}
          </a>
        );
      })}
      <div class="mt-3 grid grid-cols-2 gap-2 border-t border-border/80 pt-3">
        <a
          href={siteConfig.github}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-border bg-surface/60 font-mono text-sm text-text-muted hover:border-accent/40 hover:text-accent"
        >
          <GitBranch size={16} aria-hidden="true" />
          Source
        </a>
        <a
          href={`mailto:${siteConfig.email}`}
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-border bg-surface/60 font-mono text-sm text-text-muted hover:border-green/40 hover:text-green"
        >
          <Mail size={16} aria-hidden="true" />
          Email
        </a>
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('mobile-menu-open-icon');
  const closeIcon = document.getElementById('mobile-menu-close-icon');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !expanded;
      btn.setAttribute('aria-expanded', String(nextExpanded));
      btn.setAttribute('aria-label', nextExpanded ? '关闭导航菜单' : '打开导航菜单');
      menu.classList.toggle('hidden');
      openIcon?.classList.toggle('hidden', nextExpanded);
      closeIcon?.classList.toggle('hidden', !nextExpanded);
    });
  }
</script>
